NODE_ENV=development
# Self-hosted Supabase PostgreSQL connection string used by Drizzle/API/worker.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres
# Shared self-hosted Supabase project settings. The service key must stay server-only.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTc4NzIzMzU2MCwiZXhwIjo0OTQyOTA3MTYwLCJyb2xlIjoiYW5vbiJ9.37lSVIaQPwn_QuZPFFtXV2mKpGQypiqzRdX5ryFfXtA
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
WEB_PORT=3000
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=/api/v1
INTERNAL_API_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-32-character-minimum-secret
# Comma-separated emails granted ADMIN on registration. Remove after bootstrapping.
ADMIN_EMAILS=admin@example.com
B2_ENDPOINT=https://s3.us-west-000.backblazeb2.com
B2_REGION=us-west-000
B2_BUCKET=streaming-media
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=21474836480
WORKER_CONCURRENCY=1
CRYPTO_PAYMENT_PROVIDER=manual
CRYPTO_PAYMENT_WEBHOOK_SECRET=
# Optional: only required for the admin TMDb metadata lookup endpoint.
# You can manually save TMDb IDs, seasons, and episodes without this key.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
POPADS_SCRIPT_URL=
VAST_TAG_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
